# Copy to .env (web root, dev) or ../private/kuruier.env (server, preferred),
# then fill in real values. Never commit the filled-in file.
# Real environment variables override anything set here.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=replace-with-gmail-app-password
RECIPIENT_EMAIL=your-account@gmail.com
